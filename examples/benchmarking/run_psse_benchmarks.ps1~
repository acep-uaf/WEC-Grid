# benchmarking/run_psse_wec_sweep.ps1
# Run PSS®E IEEE-39 benchmarks with multiple WEC farm configs (skip baseline).

# Ensure output folder exists
New-Item -ItemType Directory -Force -Path .\perf | Out-Null

# Parameters
$backend = "psse"
$runs    = 10
$warmup  = 10

# Only IEEE-39 for this sweep
$cases = @("..\grid_models\IEEE_39_bus.RAW")

# Where your WEC farm configs live
$wecConfigDir = ".\wec_farm_config"

function Run-Benchmark {
    param(
        [string]$CasePath,
        [string]$Outfile,
        [string]$Backend,
        [int]$Runs,
        [int]$WarmupSteps,
        [string]$WecFile
    )

    $args = @(
        ".\benchmark_wecgrid.py",
        "--case", $CasePath,
        "--backend", $Backend,
        "--runs", $Runs,
        "--warmup-steps", $WarmupSteps,
        "--outfile", $Outfile,
        "--wec-file", $WecFile
    )

    python $args
    if ($LASTEXITCODE -eq 0) {
        Write-Host ">>> Saved: $Outfile"
    } else {
        Write-Host ">>> Error ($LASTEXITCODE) for $Outfile"
    }
}

foreach ($case in $cases) {
    $base = [System.IO.Path]::GetFileNameWithoutExtension($case)   # "IEEE_39_bus"
    $stem = ($base -replace '^IEEE_','ieee') -replace '_bus$',''    # "ieee39"

    Write-Host "===================================================="
    Write-Host "Grid: $base   Backend: $backend   Runs: $runs   Warm-up: $warmup"
    Write-Host "===================================================="

    # WEC configs: ieee39_wecfarm_1.json, _2.json, _3.json
    $pattern = "${stem}_wecfarm_*.json"
    $wecFiles = Get-ChildItem -Path $wecConfigDir -Filter $pattern | Sort-Object Name

    foreach ($wf in $wecFiles) {
        $suffix = ($wf.BaseName -replace '.*_wecfarm_','')
        $outW   = ".\perf\${backend}_${base}_wec_${suffix}.json"

        Write-Host "-> With WEC config [$suffix]: $outW"
        Run-Benchmark -CasePath $case -Outfile $outW -Backend $backend -Runs $runs -WarmupSteps $warmup -WecFile $wf.FullName
    }
    Write-Host ""
}